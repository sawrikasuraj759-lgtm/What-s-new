{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account information, wallet balance, and server-managed subscription metadata",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Immutable Firebase UID owner identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "User display name",
          "minLength": 1,
          "maxLength": 64
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 128
        },
        "plan": {
          "type": "string",
          "description": "Active subscription tier (mini, pro, or business)",
          "enum": ["mini", "pro", "business"]
        },
        "subscriptionStatus": {
          "type": "string",
          "description": "Subscription lifecycle status",
          "enum": ["FREE", "ACTIVE", "EXPIRED"]
        },
        "subscriptionExpiresAt": {
          "type": "string",
          "description": "ISO timestamp when paid subscription expires",
          "maxLength": 64
        },
        "coins": {
          "type": "number",
          "description": "User coin balance"
        },
        "isSuspended": {
          "type": "boolean",
          "description": "Admin suspension flag"
        },
        "botSlotsUsed": {
          "type": "number",
          "description": "Number of deployed bot slots in use"
        },
        "botSlotsTotal": {
          "type": "number",
          "description": "Total allowed bot slots"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["username", "email", "plan", "coins", "createdAt", "updatedAt"]
    },
    "BotEntity": {
      "title": "BotEntity",
      "description": "Deployed bot instance metadata and configuration",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Immutable owner UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Bot instance name",
          "minLength": 1,
          "maxLength": 64
        },
        "templateName": {
          "type": "string",
          "description": "Template name",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Current bot container status",
          "enum": ["running", "stopped", "rebuilding", "deploying"]
        },
        "phoneNumber": {
          "type": "string",
          "description": "Paired WhatsApp phone number",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update server timestamp"
        }
      },
      "required": ["ownerId", "name", "status", "createdAt", "updatedAt"]
    },
    "TransactionEntity": {
      "title": "TransactionEntity",
      "description": "User wallet ledger transaction record",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Owner UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Transaction title",
          "maxLength": 120
        },
        "amount": {
          "type": "number",
          "description": "Delta amount"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp"
        }
      },
      "required": ["ownerId", "title", "amount", "createdAt"]
    },
    "PurchaseRequestEntity": {
      "title": "PurchaseRequestEntity",
      "description": "Customer purchase request for coins or tier plans",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "description": "Customer Firebase UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerEmail": {
          "type": "string",
          "description": "Customer email address",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "description": "Customer display name",
          "maxLength": 64
        },
        "itemType": {
          "type": "string",
          "description": "Type of item requested",
          "enum": ["plan", "coin_pack"]
        },
        "itemName": {
          "type": "string",
          "description": "Name of plan or coin pack",
          "maxLength": 128
        },
        "priceLkr": {
          "type": "number",
          "description": "Price in Sri Lankan Rupees"
        },
        "status": {
          "type": "string",
          "description": "Approval status",
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "referenceId": {
          "type": "string",
          "description": "Unique purchase reference ID",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Update server timestamp"
        }
      },
      "required": ["customerId", "customerEmail", "itemType", "itemName", "priceLkr", "status", "createdAt", "updatedAt"]
    },
    "SubscriptionPaymentRequest": {
      "title": "SubscriptionPaymentRequest",
      "description": "Manual bank transfer subscription request metadata (receipt file stored securely on server disk)",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerEmail": {
          "type": "string",
          "description": "Customer email",
          "maxLength": 128
        },
        "packageId": {
          "type": "string",
          "description": "Requested monthly tier",
          "enum": ["pro", "business"]
        },
        "expectedAmountLkr": {
          "type": "number",
          "description": "Expected LKR amount"
        },
        "transactionReference": {
          "type": "string",
          "description": "Bank transaction reference",
          "minLength": 4,
          "maxLength": 80
        },
        "paymentDate": {
          "type": "string",
          "description": "Date of bank transfer YYYY-MM-DD",
          "maxLength": 20
        },
        "receiptPath": {
          "type": "string",
          "description": "Server API receipt reference path",
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "description": "Approval workflow status",
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "createdAt": {
          "type": "string",
          "description": "Submission server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Review server timestamp"
        }
      },
      "required": ["userId", "customerEmail", "packageId", "expectedAmountLkr", "transactionReference", "paymentDate", "status", "createdAt", "updatedAt"]
    },
    "PlatformBillingConfig": {
      "title": "PlatformBillingConfig",
      "description": "Public read-only bank account and package price configuration managed by admins",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "maxLength": 120 },
        "accountName": { "type": "string", "maxLength": 120 },
        "accountNumber": { "type": "string", "maxLength": 60 },
        "branchName": { "type": "string", "maxLength": 120 },
        "proPriceLkr": { "type": "number" },
        "businessPriceLkr": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["bankName", "accountName", "accountNumber", "proPriceLkr", "businessPriceLkr", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Authorized administrator registry document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["ADMIN"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable admin security and approval audit log",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 80 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["adminEmail", "action", "details", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores individual user account profile and wallet data strictly by Firebase UID"
    },
    "/users/{userId}/bots/{botId}": {
      "schema": "BotEntity",
      "description": "Stores individual user bot deployments strictly by Firebase UID"
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": "TransactionEntity",
      "description": "Stores user wallet transaction history"
    },
    "/purchase_requests/{reqId}": {
      "schema": "PurchaseRequestEntity",
      "description": "Stores customer purchase requests accessible only by owner customer or admin"
    },
    "/subscription_requests/{requestId}": {
      "schema": "SubscriptionPaymentRequest",
      "description": "Manual bank transfer payment requests (metadata only, admin-approved)"
    },
    "/platform_config/{configId}": {
      "schema": "PlatformBillingConfig",
      "description": "Bank details and monthly LKR package prices readable by signed-in users, writable only by admin"
    },
    "/admins/{uid}": {
      "schema": "AdminMarker",
      "description": "Authorized admin lookup documents"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Admin action audit trail"
    }
  }
}
